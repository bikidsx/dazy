{
  "name": "mailhog",
  "description": "Email testing tool for developers",
  "version": "1.0.0",
  "tags": ["email", "testing", "development"],
  "image": "mailhog/mailhog:latest",
  "ports": [
    {
      "host": 1025,
      "container": 1025,
      "protocol": "tcp"
    },
    {
      "host": 8025,
      "container": 8025,
      "protocol": "tcp"
    }
  ],
  "restart": "unless-stopped"
}
