{
  "name": "minio",
  "description": "MinIO S3-compatible object storage",
  "version": "1.0.0",
  "tags": ["storage", "s3", "minio"],
  "image": "minio/minio:latest",
  "ports": [
    {
      "host": 9000,
      "container": 9000,
      "protocol": "tcp"
    },
    {
      "host": 9001,
      "container": 9001,
      "protocol": "tcp"
    }
  ],
  "environment": {
    "MINIO_ROOT_USER": "${MINIO_USER}",
    "MINIO_ROOT_PASSWORD": "${MINIO_PASSWORD}"
  },
  "volumes": [
    {
      "source": "minio-data",
      "target": "/data"
    }
  ],
  "command": ["server", "/data", "--console-address", ":9001"],
  "restart": "unless-stopped",
  "variables": [
    {
      "name": "MINIO_USER",
      "description": "MinIO root user",
      "default": "minioadmin",
      "type": "string"
    },
    {
      "name": "MINIO_PASSWORD",
      "description": "MinIO root password (min 8 chars)",
      "required": true,
      "type": "password"
    }
  ]
}
