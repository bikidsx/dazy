{
  "name": "redis",
  "description": "Redis in-memory data store",
  "version": "1.0.0",
  "tags": ["cache", "database", "redis"],
  "image": "redis:7-alpine",
  "ports": [
    {
      "host": 6379,
      "container": 6379,
      "protocol": "tcp"
    }
  ],
  "volumes": [
    {
      "source": "redis-data",
      "target": "/data"
    }
  ],
  "command": ["redis-server", "--appendonly", "yes"],
  "restart": "unless-stopped",
  "healthcheck": {
    "test": ["CMD", "redis-cli", "ping"],
    "interval": "10s",
    "timeout": "5s",
    "retries": 3
  }
}
