{
  "name": "mongodb",
  "description": "MongoDB document database",
  "version": "1.0.0",
  "tags": ["database", "nosql", "mongodb"],
  "image": "mongo:6",
  "ports": [
    {
      "host": 27017,
      "container": 27017,
      "protocol": "tcp"
    }
  ],
  "environment": {
    "MONGO_INITDB_ROOT_USERNAME": "${MONGO_USER}",
    "MONGO_INITDB_ROOT_PASSWORD": "${MONGO_PASSWORD}"
  },
  "volumes": [
    {
      "source": "mongo-data",
      "target": "/data/db"
    }
  ],
  "restart": "unless-stopped",
  "variables": [
    {
      "name": "MONGO_USER",
      "description": "Root username",
      "default": "admin",
      "type": "string"
    },
    {
      "name": "MONGO_PASSWORD",
      "description": "Root password",
      "required": true,
      "type": "password"
    }
  ]
}
